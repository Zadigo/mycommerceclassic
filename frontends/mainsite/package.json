    "happy-dom": "^20.11.6",
    "nuxt-vuefire": "^1.1.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-test": "^14.1.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10",
    "zod": "^4.4.3"
