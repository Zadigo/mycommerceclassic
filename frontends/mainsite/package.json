{
  "name": "mainsite",
  "version": "0.1.0-dev1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:debug": "DEBUG=nitro:* pnpm build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch --coverage",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:nuxt": "vitest run --project nuxt",
    "test:playwright": "playwright test",
    "test:playwright:report": "playwright show-report",
    "test:playwright:ui": "playwright test --ui",
    "release": "pnpm run lint & pnpm run test && pnpm run build && npx changelogen --release && git push --follow-tags",
    "release:major": "pnpm run lint & pnpm run test && pnpm run build && npx changelogen --release --major && git push --follow-tags",
    "release:minor": "pnpm run lint & pnpm run test && pnpm run build && npx changelogen --release --minor && git push --follow-tags",
    "release:patch": "pnpm run lint & pnpm run test && pnpm run build && npx changelogen --release --patch && git push --follow-tags",
    "prerelease": "pnpm run lint & pnpm run test && pnpm run build && npx changelogen --prerelease --bump && git push --follow-tags",
    "prerelease:patch": "pnpm run lint & pnpm run test && pnpm run build && npx changelogen --prepatch && git push --follow-tags",
    "prerelease:minor": "pnpm run lint & pnpm run test && pnpm run build && npx changelogen --preminor && git push --follow-tags",
    "prerelease:major": "pnpm run lint & pnpm run test && pnpm run build && npx changelogen --premajor && git push --follow-tags",
    "playwright:install": "playwright install --with-deps",
    "cleanup": "nuxt cleanup && rm -rf .nuxt .output dist node_modules/.cache",
    "lint": "oxlint lint .",
    "lint:eslint": "eslint . --ext .ts,.vue",
    "fix": "oxlint fix ."
  },
  "dependencies": {
    "@iconify-json/simple-icons": "^1.2.95",
