    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/seo": "5.3.14",
    "@pinia/nuxt": "1.0.2",
    "@vueuse/nuxt": "14.4.0",
    "firebase": "^12.18.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vuefire": "^3.2.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@firebase/app-types": "^0.9.6",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "@vue/test-utils": "^2.4.11",
